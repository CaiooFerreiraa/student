generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  runtime         = "bun"
  moduleFormat    = "esm"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum EducationLevel {
  ELEMENTARY
  HIGH_SCHOOL
  UNDERGRADUATE
  GRADUATE
  OTHER
}

enum FilePurpose {
  MATERIAL
  ESSAY_SUBMISSION
  AVATAR
  CONVERSATION_ATTACHMENT
}

enum FileStatus {
  PENDING
  AVAILABLE
  DELETE_PENDING
  DELETED
  FAILED
}

enum MaterialType {
  PDF
  DOCX
  IMAGE
  TEXT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum QuizStatus {
  DRAFT
  GENERATING
  READY
  ARCHIVED
}

enum QuizVersionStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
  FAILED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuizMode {
  STUDY
  SIMULATION
}

enum GenerationMode {
  MANUAL
  AI
  HYBRID
}

enum AnswerRevealMode {
  AFTER_QUESTION
  AFTER_SUBMIT
  NEVER
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum GradingStatus {
  NOT_REQUIRED
  PENDING
  GRADED
  FAILED
}

enum GradedBy {
  SYSTEM
  AI
  MANUAL
}

enum ReviewStatus {
  ACTIVE
  SNOOZED
  COMPLETED
}

enum EssayType {
  ENEM
  DISSERTATIVE
  FREE
}

enum EssayInputType {
  TEXT
  DOCX
  IMAGE
}

enum EssaySubmissionStatus {
  UPLOADED
  EXTRACTING
  NEEDS_REVIEW
  READY_TO_GRADE
  GRADING
  GRADED
  FAILED
}

enum EssayEvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AiFeature {
  MATERIAL_SUMMARY
  MATERIAL_EMBEDDING
  QUIZ_GENERATION
  OPEN_ANSWER_GRADING
  ESSAY_TRANSCRIPTION
  ESSAY_GRADING
  CHAT
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum JobKind {
  PROCESS_MATERIAL
  GENERATE_QUIZ
  TRANSCRIBE_ESSAY
  GRADE_ESSAY
  DELETE_BLOB
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String               @unique @db.VarChar(320)
  displayName      String               @db.VarChar(120)
  status           UserStatus           @default(ACTIVE)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?            @db.Timestamptz(3)
  profile          Profile?
  preferences      UserPreference?
  identities       UserIdentity[]
  files            FileAsset[]          @relation("OwnedFiles")
  folders          Folder[]
  subjects         Subject[]
  tags             Tag[]
  materials        Material[]
  quizzes          Quiz[]
  attempts         QuizAttempt[]
  reviewSchedules  QuizReviewSchedule[]
  essayRubrics     EssayRubric[]
  essayAssignments EssayAssignment[]
  essaySubmissions EssaySubmission[]
  conversations    Conversation[]
  aiRuns           AiRun[]
  jobs             BackgroundJob[]

  @@index([status, createdAt(sort: Desc)])
  @@map("users")
}

model UserPreference {
  userId                  String          @id @db.Uuid
  theme                   ThemePreference @default(LIGHT)
  reviewNotifications     Boolean         @default(true)
  weeklySummary           Boolean         @default(true)
  processingNotifications Boolean         @default(true)
  alwaysShowSources       Boolean         @default(true)
  adaptToEducationLevel   Boolean         @default(true)
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(3)
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserIdentity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  provider  String   @db.VarChar(50)
  subject   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model Profile {
  userId                 String         @id @db.Uuid
  avatarFileId           String?        @unique @db.Uuid
  bio                    String?        @db.VarChar(500)
  educationLevel         EducationLevel @default(UNDERGRADUATE)
  primaryGoal            String?        @db.VarChar(160)
  timezone               String         @default("America/Bahia") @db.VarChar(80)
  locale                 String         @default("pt-BR") @db.VarChar(20)
  weeklyStudyGoalMinutes Int            @default(480)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarFile             FileAsset?     @relation("ProfileAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  @@map("profiles")
}

model Subject {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String?           @db.Uuid
  name             String            @db.VarChar(100)
  slug             String            @db.VarChar(120)
  color            String?           @db.VarChar(20)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  materials        Material[]
  quizzes          Quiz[]
  essayAssignments EssayAssignment[]

  @@unique([ownerId, slug])
  @@index([name])
  @@map("subjects")
}

model Tag {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String        @db.Uuid
  name      String        @db.VarChar(50)
  slug      String        @db.VarChar(60)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  materials MaterialTag[]
  quizzes   QuizTag[]

  @@unique([ownerId, slug])
  @@map("tags")
}

model FileAsset {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String                @db.Uuid
  purpose      FilePurpose
  status       FileStatus            @default(PENDING)
  pathname     String                @unique @db.VarChar(1024)
  url          String                @db.Text
  downloadUrl  String?               @db.Text
  originalName String                @db.VarChar(255)
  contentType  String                @db.VarChar(150)
  byteSize     BigInt
  checksum     String?               @db.VarChar(128)
  uploadedAt   DateTime              @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime?             @db.Timestamptz(3)
  owner        User                  @relation("OwnedFiles", fields: [ownerId], references: [id], onDelete: Restrict)
  avatarFor    Profile?              @relation("ProfileAvatar")
  material     Material?
  essayFiles   EssaySubmissionFile[]

  @@index([ownerId, purpose, status, uploadedAt(sort: Desc)])
  @@index([ownerId, checksum])
  @@map("file_assets")
}

model Folder {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String     @db.Uuid
  parentId  String?    @db.Uuid
  name      String     @db.VarChar(100)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  materials Material[]

  @@unique([ownerId, parentId, name])
  @@index([ownerId, parentId])
  @@map("folders")
}

model Material {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String                 @db.Uuid
  fileId           String                 @unique @db.Uuid
  folderId         String?                @db.Uuid
  subjectId        String?                @db.Uuid
  title            String                 @db.VarChar(255)
  type             MaterialType
  processingStatus ProcessingStatus       @default(PENDING)
  pageCount        Int?
  summary          String?                @db.Text
  metadata         Json?
  processingError  String?                @db.Text
  processedAt      DateTime?              @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?              @db.Timestamptz(3)
  owner            User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  file             FileAsset              @relation(fields: [fileId], references: [id], onDelete: Restrict)
  folder           Folder?                @relation(fields: [folderId], references: [id], onDelete: SetNull)
  subject          Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chunks           MaterialChunk[]
  tags             MaterialTag[]
  quizVersions     QuizVersionMaterial[]
  conversations    ConversationMaterial[]

  @@index([ownerId, processingStatus, createdAt(sort: Desc)])
  @@index([ownerId, folderId, createdAt(sort: Desc)])
  @@index([ownerId, subjectId])
  @@map("materials")
}

model MaterialTag {
  materialId String   @db.Uuid
  tagId      String   @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([materialId, tagId])
  @@index([tagId])
  @@map("material_tags")
}

model MaterialChunk {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId      String                       @db.Uuid
  position        Int
  pageStart       Int?
  pageEnd         Int?
  content         String                       @db.Text
  tokenCount      Int?
  contentHash     String                       @db.VarChar(128)
  metadata        Json?
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)
  material        Material                     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  questionSources QuestionSource[]

  @@unique([materialId, position])
  @@index([materialId, pageStart])
  @@index([contentHash])
  @@map("material_chunks")
}

model Quiz {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String               @db.Uuid
  subjectId        String?              @db.Uuid
  currentVersionId String?              @unique @db.Uuid
  title            String               @db.VarChar(160)
  description      String?              @db.VarChar(1000)
  status           QuizStatus           @default(DRAFT)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?            @db.Timestamptz(3)
  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subject          Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  currentVersion   QuizVersion?         @relation("CurrentQuizVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         QuizVersion[]        @relation("QuizVersions")
  tags             QuizTag[]
  attempts         QuizAttempt[]
  reviewSchedules  QuizReviewSchedule[]

  @@index([ownerId, status, updatedAt(sort: Desc)])
  @@index([ownerId, subjectId])
  @@map("quizzes")
}

model QuizTag {
  quizId String @db.Uuid
  tagId  String @db.Uuid
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([quizId, tagId])
  @@index([tagId])
  @@map("quiz_tags")
}

model QuizVersion {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId                 String                @db.Uuid
  versionNumber          Int
  status                 QuizVersionStatus     @default(DRAFT)
  educationLevel         EducationLevel
  difficulty             DifficultyLevel
  mode                   QuizMode              @default(STUDY)
  generationMode         GenerationMode        @default(AI)
  answerRevealMode       AnswerRevealMode      @default(AFTER_SUBMIT)
  requestedQuestionCount Int
  questionDistribution   Json?
  timeLimitSeconds       Int?
  timePerQuestionSeconds Int?
  totalPoints            Int                   @default(0)
  generationModel        String?               @db.VarChar(100)
  promptVersion          String?               @db.VarChar(100)
  publishedAt            DateTime?             @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  quiz                   Quiz                  @relation("QuizVersions", fields: [quizId], references: [id], onDelete: Cascade)
  currentForQuiz         Quiz?                 @relation("CurrentQuizVersion")
  materials              QuizVersionMaterial[]
  questions              Question[]
  attempts               QuizAttempt[]
  essayAssignments       EssayAssignment[]

  @@unique([quizId, versionNumber])
  @@index([quizId, status])
  @@map("quiz_versions")
}

model QuizVersionMaterial {
  quizVersionId String      @db.Uuid
  materialId    String      @db.Uuid
  quizVersion   QuizVersion @relation(fields: [quizVersionId], references: [id], onDelete: Cascade)
  material      Material    @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([quizVersionId, materialId])
  @@index([materialId])
  @@map("quiz_version_materials")
}

model Question {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizVersionId       String           @db.Uuid
  position            Int
  type                QuestionType
  statement           String           @db.Text
  explanation         String?          @db.Text
  difficulty          DifficultyLevel
  points              Int              @default(1)
  correctBoolean      Boolean?
  modelAnswer         String?          @db.Text
  gradingRubric       Json?
  minimumAnswerLength Int?
  maximumAnswerLength Int?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  quizVersion         QuizVersion      @relation(fields: [quizVersionId], references: [id], onDelete: Cascade)
  options             QuestionOption[]
  sources             QuestionSource[]
  answers             AttemptAnswer[]

  @@unique([quizVersionId, position])
  @@index([quizVersionId, type])
  @@map("questions")
}

model QuestionOption {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId  String          @db.Uuid
  position    Int
  content     String          @db.Text
  isCorrect   Boolean         @default(false)
  explanation String?         @db.Text
  question    Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedBy  AttemptAnswer[]

  @@unique([questionId, position])
  @@index([questionId, isCorrect])
  @@map("question_options")
}

model QuestionSource {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String        @db.Uuid
  chunkId    String        @db.Uuid
  pageStart  Int?
  pageEnd    Int?
  excerpt    String?       @db.Text
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chunk      MaterialChunk @relation(fields: [chunkId], references: [id], onDelete: Restrict)

  @@unique([questionId, chunkId])
  @@index([chunkId])
  @@map("question_sources")
}

model QuizAttempt {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @db.Uuid
  quizId          String               @db.Uuid
  quizVersionId   String               @db.Uuid
  status          AttemptStatus        @default(IN_PROGRESS)
  startedAt       DateTime             @default(now()) @db.Timestamptz(3)
  submittedAt     DateTime?            @db.Timestamptz(3)
  durationSeconds Int?
  score           Decimal?             @db.Decimal(8, 2)
  maximumScore    Decimal?             @db.Decimal(8, 2)
  percentage      Decimal?             @db.Decimal(5, 2)
  correctCount    Int                  @default(0)
  incorrectCount  Int                  @default(0)
  unansweredCount Int                  @default(0)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz            Quiz                 @relation(fields: [quizId], references: [id], onDelete: Restrict)
  quizVersion     QuizVersion          @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  answers         AttemptAnswer[]
  reviewSchedules QuizReviewSchedule[]

  @@index([userId, status, startedAt(sort: Desc)])
  @@index([userId, quizId, submittedAt(sort: Desc)])
  @@index([quizVersionId])
  @@map("quiz_attempts")
}

model AttemptAnswer {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId            String          @db.Uuid
  questionId           String          @db.Uuid
  selectedOptionId     String?         @db.Uuid
  booleanAnswer        Boolean?
  textAnswer           String?         @db.Text
  gradingStatus        GradingStatus   @default(NOT_REQUIRED)
  isCorrect            Boolean?
  pointsAwarded        Decimal?        @db.Decimal(8, 2)
  feedback             String?         @db.Text
  gradedBy             GradedBy?
  gradingModel         String?         @db.VarChar(100)
  gradingPromptVersion String?         @db.VarChar(100)
  answeredAt           DateTime        @default(now()) @db.Timestamptz(3)
  gradedAt             DateTime?       @db.Timestamptz(3)
  attempt              QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question             Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption       QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("attempt_answers")
}

model QuizReviewSchedule {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @db.Uuid
  quizId          String       @db.Uuid
  lastAttemptId   String?      @db.Uuid
  status          ReviewStatus @default(ACTIVE)
  nextReviewAt    DateTime     @db.Timestamptz(3)
  intervalDays    Int          @default(1)
  repetitionCount Int          @default(0)
  easeFactor      Decimal      @default(2.50) @db.Decimal(4, 2)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz            Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  lastAttempt     QuizAttempt? @relation(fields: [lastAttemptId], references: [id], onDelete: SetNull)

  @@unique([userId, quizId])
  @@index([userId, status, nextReviewAt])
  @@map("quiz_review_schedules")
}

model EssayRubric {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String?                @db.Uuid
  name         String                 @db.VarChar(120)
  version      Int
  essayType    EssayType
  maximumScore Int
  isActive     Boolean                @default(true)
  activeFrom   DateTime?              @db.Timestamptz(3)
  activeUntil  DateTime?              @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  owner        User?                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  criteria     EssayRubricCriterion[]
  assignments  EssayAssignment[]
  evaluations  EssayEvaluation[]

  @@unique([ownerId, name, version])
  @@index([essayType, isActive])
  @@map("essay_rubrics")
}

model EssayRubricCriterion {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rubricId     String                @db.Uuid
  code         String                @db.VarChar(30)
  position     Int
  name         String                @db.VarChar(160)
  description  String                @db.Text
  maximumScore Int
  levels       Json?
  rubric       EssayRubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores       EssayCriterionScore[]

  @@unique([rubricId, code])
  @@unique([rubricId, position])
  @@map("essay_rubric_criteria")
}

model EssayAssignment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String            @db.Uuid
  subjectId        String?           @db.Uuid
  quizVersionId    String?           @db.Uuid
  rubricId         String            @db.Uuid
  title            String            @db.VarChar(180)
  prompt           String            @db.Text
  essayType        EssayType
  supportingTexts  Json?
  minimumLines     Int?
  maximumLines     Int?
  timeLimitSeconds Int?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subject          Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  quizVersion      QuizVersion?      @relation(fields: [quizVersionId], references: [id], onDelete: Cascade)
  rubric           EssayRubric       @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  submissions      EssaySubmission[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([quizVersionId])
  @@map("essay_assignments")
}

model EssaySubmission {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId      String                @db.Uuid
  userId            String                @db.Uuid
  finalEvaluationId String?               @unique @db.Uuid
  inputType         EssayInputType
  status            EssaySubmissionStatus @default(UPLOADED)
  originalText      String?               @db.Text
  confirmedText     String?               @db.Text
  startedAt         DateTime              @default(now()) @db.Timestamptz(3)
  submittedAt       DateTime?             @db.Timestamptz(3)
  confirmedAt       DateTime?             @db.Timestamptz(3)
  gradedAt          DateTime?             @db.Timestamptz(3)
  assignment        EssayAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  finalEvaluation   EssayEvaluation?      @relation("FinalEssayEvaluation", fields: [finalEvaluationId], references: [id], onDelete: SetNull)
  files             EssaySubmissionFile[]
  transcriptions    EssayTranscription[]
  evaluations       EssayEvaluation[]     @relation("SubmissionEvaluations")

  @@index([userId, status, startedAt(sort: Desc)])
  @@index([assignmentId, userId])
  @@map("essay_submissions")
}

model EssaySubmissionFile {
  submissionId String          @db.Uuid
  fileId       String          @db.Uuid
  position     Int
  pageNumber   Int?
  submission   EssaySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  file         FileAsset       @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([submissionId, fileId])
  @@unique([submissionId, position])
  @@index([fileId])
  @@map("essay_submission_files")
}

model EssayTranscription {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId      String          @db.Uuid
  versionNumber     Int
  rawText           String          @db.Text
  normalizedText    String          @db.Text
  confidence        Decimal?        @db.Decimal(5, 4)
  uncertainSegments Json?
  model             String?         @db.VarChar(100)
  promptVersion     String?         @db.VarChar(100)
  confirmedByUserAt DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  submission        EssaySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, versionNumber])
  @@map("essay_transcriptions")
}

model EssayEvaluation {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId    String                @db.Uuid
  rubricId        String                @db.Uuid
  evaluatorIndex  Int                   @default(1)
  status          EssayEvaluationStatus @default(PENDING)
  totalScore      Int?
  summary         String?               @db.Text
  strengths       Json?
  improvementPlan Json?
  model           String?               @db.VarChar(100)
  promptVersion   String?               @db.VarChar(100)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?             @db.Timestamptz(3)
  submission      EssaySubmission       @relation("SubmissionEvaluations", fields: [submissionId], references: [id], onDelete: Cascade)
  finalFor        EssaySubmission?      @relation("FinalEssayEvaluation")
  rubric          EssayRubric           @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  scores          EssayCriterionScore[]

  @@unique([submissionId, evaluatorIndex])
  @@index([submissionId, status])
  @@map("essay_evaluations")
}

model EssayCriterionScore {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluationId String               @db.Uuid
  criterionId  String               @db.Uuid
  score        Int
  feedback     String               @db.Text
  evidence     Json?
  suggestions  Json?
  evaluation   EssayEvaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    EssayRubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
  @@map("essay_criterion_scores")
}

model Conversation {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                 @db.Uuid
  title     String                 @db.VarChar(180)
  status    ConversationStatus     @default(ACTIVE)
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @db.Timestamptz(3)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials ConversationMaterial[]
  messages  ConversationMessage[]

  @@index([userId, status, updatedAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMaterial {
  conversationId String       @db.Uuid
  materialId     String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([conversationId, materialId])
  @@index([materialId])
  @@map("conversation_materials")
}

model ConversationMessage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  structuredData Json?
  toolName       String?      @db.VarChar(100)
  toolCallId     String?      @db.VarChar(150)
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([toolCallId])
  @@map("conversation_messages")
}

model AiRun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  feature       AiFeature
  targetType    String?   @db.VarChar(80)
  targetId      String?   @db.Uuid
  status        RunStatus @default(PENDING)
  model         String    @db.VarChar(100)
  promptVersion String    @db.VarChar(100)
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  metadata      Json?
  errorCode     String?   @db.VarChar(100)
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  completedAt   DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, feature, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("ai_runs")
}

model BackgroundJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?   @db.Uuid
  kind           JobKind
  status         JobStatus @default(PENDING)
  targetType     String    @db.VarChar(80)
  targetId       String    @db.Uuid
  idempotencyKey String    @unique @db.VarChar(180)
  payload        Json?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAfter       DateTime  @default(now()) @db.Timestamptz(3)
  lockedAt       DateTime? @db.Timestamptz(3)
  lockedBy       String?   @db.VarChar(120)
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, runAfter])
  @@index([targetType, targetId])
  @@map("background_jobs")
}
